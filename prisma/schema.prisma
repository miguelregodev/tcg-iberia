// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  JAPANESE
  KOREAN
  ENGLISH
  SPANISH
}

enum OrderStatus {
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  TELEGRAM
}

/// AnnouncementBanner model stores rotating announcement messages shown site-wide below the navigation.
/// Administrators manage banners from the Admin Panel (/admin/banners).
/// Only banners with enabled=true are served to the storefront.
/// Banners are displayed in ascending displayOrder order.
model AnnouncementBanner {
  id           String   @id @default(cuid())
  text         String   @db.VarChar(500)
  enabled      Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enabled])
  @@index([displayOrder])
}

/// Product model represents a TCG/Pokemon card product in the catalog
/// Fields:
/// - id: Unique identifier (auto-generated CUID)
/// - name: Product name/title (max 255 chars)
/// - slug: URL-friendly identifier (unique, auto-generated from name)
/// - description: Detailed product description (text field for long content)
/// - price: Product price in EUR (decimal with 2 decimal places)
/// - stock: Number of units available (0 means sold out)
/// - imageUrl: S3 URL to product image (optional)
/// - priority: Display order in catalog (lower numbers appear first, default: 999)
/// - visible: Whether product appears on public catalog (default: true)
/// - createdAt: Timestamp when product was created (auto-set)
/// - updatedAt: Timestamp of last update (auto-updated)
/// - hitCards: Relationship to hit cards associated with this product
/// 
/// Indexes:
/// - visible: For filtering public products
/// - slug: For product detail page lookups
/// - priority: For ordering products by priority
/// 
/// Constraints:
/// - slug: UNIQUE to prevent duplicate URLs
model Product {
  id                   String   @id @default(cuid())
  name                 String   @db.VarChar(255)
  slug                 String   @unique @db.VarChar(255)
  description          String   @db.Text
  price                Decimal  @db.Decimal(10, 2)
  discountPercentage   Decimal? @db.Decimal(5, 2)
  notes                String?  @db.Text
  type                 String?  @db.VarChar(100)
  releaseDate          DateTime?
  stock                Int      @default(0)
  imageUrl             String?  @db.VarChar(500)
  language             Language @default(ENGLISH)
  priority             Int      @default(999)
  visible              Boolean  @default(true)
  favoriteCount        Int      @default(0)  // denormalized counter — kept in sync via API transactions
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  hitCards             HitCard[]
  favorites            Favorite[]
  stockAlerts          StockAlert[]

  @@index([visible])
  @@index([slug])
  @@index([language])
  @@index([priority])
  @@index([releaseDate])
  @@index([favoriteCount])  // supports sorting by popularity
}

/// HitCard model represents promotional/best hit cards associated with a product
/// Fields:
/// - id: Unique identifier (auto-generated CUID)
/// - productId: Foreign key reference to Product
/// - product: Relationship to the Product
/// - name: Hit card name/title (max 255 chars)
/// - type: Type of hit card (string field for flexibility)
/// - imageUrl: Supabase storage URL to hit card image
/// - marketPrice: Market price of the hit card in EUR (decimal with 2 decimal places)
/// - createdAt: Timestamp when hit card was created (auto-set)
/// - updatedAt: Timestamp of last update (auto-updated)
/// 
/// Indexes:
/// - productId: For filtering hit cards by product
/// 
/// Constraints:
/// - productId: Foreign key to Product, cascade delete
model HitCard {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String   @db.VarChar(255)
  type          String   @db.VarChar(100)
  imageUrl      String   @db.VarChar(500)
  marketPrice   Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
}

/// Order model represents a customer order
/// Fields:
/// - id: Unique identifier (auto-generated CUID)
/// - fullName: Customer's full name
/// - email: Customer's email address
/// - phone: Customer's phone number
/// - shippingAddress: Street address
/// - shippingPostalCode: Postal/ZIP code
/// - shippingCity: City name
/// - shippingLocality: Locality/Region
/// - shippingProvince: Province/State
/// - totalAmount: Total order amount in EUR
/// - status: Order status (PROCESSING, COMPLETED, FAILED, CANCELLED)
/// - stripeSessionId: Stripe checkout session ID for payment tracking
/// - items: JSON array of ordered items
/// - createdAt: Timestamp when order was created
/// - updatedAt: Timestamp of last update
/// 
/// Indexes:
/// - email: For finding orders by customer email
/// - stripeSessionId: For finding orders by Stripe session
/// - status: For filtering orders by status
model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique @db.VarChar(50)
  userId                String?     // nullable – guest orders have no userId
  fullName              String      @db.VarChar(255)
  email                 String      @db.VarChar(255)
  phone                 String      @db.VarChar(20)
  shippingAddress       String      @db.Text
  shippingPostalCode    String      @db.VarChar(20)
  shippingCity          String      @db.VarChar(255)
  shippingLocality      String      @db.VarChar(255)
  shippingProvince      String      @db.VarChar(255)
  totalAmount           Decimal     @db.Decimal(12, 2)
  status                OrderStatus @default(PROCESSING)
  stripeSessionId       String?     @unique @db.VarChar(500)
  items                 Json        // Array of {productId, name, quantity, price, discountPercentage}
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([userId])
  @@index([status])
}

/// Sequence model represents a sequence for auto-incrementing IDs
/// Fields:
/// - name: ORDER
/// - value: incrementing value
model Sequence {
  name                  String      @id
  value                 Int
}

// ─── Auth.js / NextAuth v5 required models ───────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

/// Customer / authenticated user account.
/// Supports both local (email + bcrypt password) and OAuth (Google) sign-in.
model User {
  id            String    @id @default(cuid())
  email         String    @unique @db.VarChar(255)
  emailVerified DateTime?
  passwordHash  String?   @db.VarChar(255)  // null for OAuth-only accounts
  fullName      String?   @db.VarChar(255)
  image         String?   @db.VarChar(500)  // OAuth profile picture
  phone         String?   @db.VarChar(30)
  addressLine   String?   @db.VarChar(255)
  postalCode    String?   @db.VarChar(20)
  city          String?   @db.VarChar(100)
  locality      String?   @db.VarChar(100)
  province      String?   @db.VarChar(100)
  country       String?   @db.VarChar(100) @default("España")
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth.js relations
  accounts      Account[]
  sessions      Session[]

  // Domain relations
  favorites     Favorite[]
  orders        Order[]   // soft link — orders are also identified by email
  stockAlerts   StockAlert[]

  @@index([email])
}

/// OAuth account linked to a User (Auth.js adapter requirement)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Database session (Auth.js adapter requirement)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Email verification token (Auth.js adapter requirement)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Favorite product saved by a user
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

/// Stock alert subscription for out-of-stock products.
/// Supports authenticated users (userId) and guest users (email only).
model StockAlert {
  id          String             @id @default(cuid())
  productId   String
  userId      String?
  email       String             @db.VarChar(255)
  channel     NotificationChannel @default(EMAIL)
  status      NotificationStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  notifiedAt  DateTime?

  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([productId, email])
  @@unique([productId, userId])
  @@index([userId])
  @@index([email])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

/// Temporary persisted checkout cart for reliable webhook inventory updates.
model CheckoutSessionCart {
  id         String    @id @default(cuid())
  sessionId  String    @unique @db.VarChar(255)
  items      Json
  createdAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([createdAt])
}
