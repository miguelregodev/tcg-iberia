// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Language {
  JAPANESE
  KOREAN
  ENGLISH
  SPANISH
}

enum OrderStatus {
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  TELEGRAM
}

/// Product variant distinguishing between shrink-wrapped and no-shrink versions
/// of the same underlying catalog product. Used to keep independent price histories
/// per variant (the left/right sections of the Google Sheets import).
enum ProductVariant {
  SHRINK
  NO_SHRINK
}

/// AnnouncementBanner model stores rotating announcement messages shown site-wide below the navigation.
/// Administrators manage banners from the Admin Panel (/admin/banners).
/// Only banners with enabled=true are served to the storefront.
/// Banners are displayed in ascending displayOrder order.
model AnnouncementBanner {
  id           String   @id @default(cuid())
  text         String   @db.VarChar(500)
  enabled      Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enabled])
  @@index([displayOrder])
}

/// Product model represents a TCG/Pokemon card product in the catalog
/// Fields:
/// - id: Unique identifier (auto-generated CUID)
/// - name: Product name/title (max 255 chars)
/// - slug: URL-friendly identifier (unique, auto-generated from name)
/// - description: Detailed product description (text field for long content)
/// - price: Product price in EUR (decimal with 2 decimal places)
/// - stock: Number of units available (0 means sold out)
/// - imageUrl: S3 URL to product image (optional)
/// - priority: Display order in catalog (lower numbers appear first, default: 999)
/// - visible: Whether product appears on public catalog (default: true)
/// - createdAt: Timestamp when product was created (auto-set)
/// - updatedAt: Timestamp of last update (auto-updated)
/// - hitCards: Relationship to hit cards associated with this product
/// 
/// Indexes:
/// - visible: For filtering public products
/// - slug: For product detail page lookups
/// - priority: For ordering products by priority
/// 
/// Constraints:
/// - slug: UNIQUE to prevent duplicate URLs
model Product {
  id                   String   @id @default(cuid())
  name                 String   @db.VarChar(255)
  slug                 String   @unique @db.VarChar(255)
  description          String   @db.Text
  price                Decimal  @db.Decimal(10, 2)
  discountPercentage   Decimal? @db.Decimal(5, 2)
  noShrinkPrice        Decimal? @db.Decimal(10, 2)
  /// Optional wholesale price for authenticated B2B customers (SHRINK variant).
  /// When present, replaces the public `price` for logged-in active B2B users.
  b2bPrice             Decimal? @db.Decimal(10, 2)
  /// Optional wholesale price for the NO_SHRINK variant. Same visibility rules
  /// as `b2bPrice`.
  b2bPriceNoShrink     Decimal? @db.Decimal(10, 2)
  notes                String?  @db.Text
  type                 String?  @db.VarChar(100)
  releaseDate          DateTime?
  stock                Int      @default(0)
  noShrinkStock        Int      @default(0)
  imageUrl             String?  @db.VarChar(500)
  language             Language @default(ENGLISH)
  priority             Int      @default(999)
  visible              Boolean  @default(true)
  favoriteCount        Int      @default(0)  // denormalized counter — kept in sync via API transactions
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  hitCards             HitCard[]
  favorites            Favorite[]
  stockAlerts          StockAlert[]
  priceMappings        PriceMapping[]
  priceHistory         PriceHistory[]

  @@index([visible])
  @@index([slug])
  @@index([language])
  @@index([priority])
  @@index([releaseDate])
  @@index([favoriteCount])  // supports sorting by popularity
  // NOTE: Additional Postgres-native indexes exist for the search feature and
  // are managed via raw SQL in migration `20260621223000_add_product_search_indexes`:
  //   - pg_trgm extension (required for substring ILIKE acceleration)
  //   - GIN trigram indexes on (name), (type) WHERE type IS NOT NULL, (description)
  //   - Composite B-tree (visible, priority) for the catalog access path
  // They are intentionally not declared here because Prisma's
  // postgresqlExtensions / ops preview features are not enabled.
}

/// PriceMapping stores permanent manual mappings from imported Google Sheets product
/// names to catalog product IDs. Once an administrator assigns a mapping, future imports
/// automatically resolve that name without requiring manual re-assignment.
model PriceMapping {
  id           String   @id @default(cuid())
  importedName String   @unique @db.VarChar(500)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([importedName])
  @@index([productId])
}

/// PriceHistory records the imported purchase price (converted JPY → EUR, before margin)
/// for every imported sheet product on each import day, regardless of whether the imported
/// row was matched to a catalog product. Independent histories are kept per product
/// variant (SHRINK / NO_SHRINK), so the Shrink and No-Shrink versions of the same
/// product never share data points.
///
/// Deduplication:
/// - A UNIQUE (sheetProductName, variant, importDate) constraint guarantees at most one
///   record per imported-name/variant/day. Multiple imports on the same calendar day
///   upsert the existing row so the "last import of the day wins".
///
/// Historical-minimum lookups:
/// - The composite index on (sheetProductName, variant, purchasePriceEur) supports
///   fast MIN() queries used to detect when today's price is the all-time low.
///
/// Chart queries:
/// - The (sheetProductName, variant, importDate) index supports ordered range scans
///   used by the historical price chart.
///
/// Catalog association:
/// - `catalogProductId` is optional. When an imported name is (or was) mapped to a
///   catalog product, the FK is populated so admins can trace history back. If the
///   catalog product is later deleted, the FK is set to NULL so the historical series
///   remains intact.
model PriceHistory {
  id                String         @id @default(cuid())
  catalogProductId  String?
  variant           ProductVariant
  sheetProductName  String         @db.VarChar(500)
  importDate        DateTime       @db.Date
  importTimestamp   DateTime       @default(now())
  priceJpy          Decimal        @db.Decimal(12, 2)
  exchangeRate      Decimal        @db.Decimal(18, 10)
  purchasePriceEur  Decimal        @db.Decimal(12, 4)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  catalogProduct    Product?       @relation(fields: [catalogProductId], references: [id], onDelete: SetNull)

  @@unique([sheetProductName, variant, importDate])
  @@index([sheetProductName, variant, importDate])
  @@index([sheetProductName, variant, purchasePriceEur])
  @@index([catalogProductId])
}

/// HitCard model represents promotional/best hit cards associated with a product
/// Fields:
/// - id: Unique identifier (auto-generated CUID)
/// - productId: Foreign key reference to Product
/// - product: Relationship to the Product
/// - name: Hit card name/title (max 255 chars)
/// - type: Type of hit card (string field for flexibility)
/// - imageUrl: Supabase storage URL to hit card image
/// - marketPrice: Market price of the hit card in EUR (decimal with 2 decimal places)
/// - createdAt: Timestamp when hit card was created (auto-set)
/// - updatedAt: Timestamp of last update (auto-updated)
/// 
/// Indexes:
/// - productId: For filtering hit cards by product
/// 
/// Constraints:
/// - productId: Foreign key to Product, cascade delete
model HitCard {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String   @db.VarChar(255)
  type          String   @db.VarChar(100)
  imageUrl      String   @db.VarChar(500)
  marketPrice   Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
}

/// Order model represents a customer order
/// Fields:
/// - id: Unique identifier (auto-generated CUID)
/// - fullName: Customer's full name
/// - email: Customer's email address
/// - phone: Customer's phone number
/// - shippingAddress: Street address
/// - shippingPostalCode: Postal/ZIP code
/// - shippingCity: City name
/// - shippingLocality: Locality/Region
/// - shippingProvince: Province/State
/// - totalAmount: Total order amount in EUR
/// - status: Order status (PROCESSING, COMPLETED, FAILED, CANCELLED)
/// - stripeSessionId: Stripe checkout session ID for payment tracking
/// - items: JSON array of ordered items
/// - createdAt: Timestamp when order was created
/// - updatedAt: Timestamp of last update
/// 
/// Indexes:
/// - email: For finding orders by customer email
/// - stripeSessionId: For finding orders by Stripe session
/// - status: For filtering orders by status
model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique @db.VarChar(50)
  userId                String?     // nullable – guest orders have no userId
  fullName              String      @db.VarChar(255)
  email                 String      @db.VarChar(255)
  phone                 String      @db.VarChar(20)
  shippingAddress       String      @db.Text
  shippingPostalCode    String      @db.VarChar(20)
  shippingCity          String      @db.VarChar(255)
  shippingLocality      String      @db.VarChar(255)
  shippingProvince      String      @db.VarChar(255)
  totalAmount           Decimal     @db.Decimal(12, 2)
  status                OrderStatus @default(PROCESSING)
  stripeSessionId       String?     @unique @db.VarChar(500)
  items                 Json        // Array of {productId, name, quantity, price, discountPercentage}
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([userId])
  @@index([status])
}

/// Sequence model represents a sequence for auto-incrementing IDs
/// Fields:
/// - name: ORDER
/// - value: incrementing value
model Sequence {
  name                  String      @id
  value                 Int
}

// ─── Auth.js / NextAuth v5 required models ───────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

/// Customer / authenticated user account.
/// Supports both local (email + bcrypt password) and OAuth (Google) sign-in.
model User {
  id            String    @id @default(cuid())
  email         String    @unique @db.VarChar(255)
  emailVerified DateTime?
  passwordHash  String?   @db.VarChar(255)  // null for OAuth-only accounts
  fullName      String?   @db.VarChar(255)
  image         String?   @db.VarChar(500)  // OAuth profile picture
  phone         String?   @db.VarChar(30)
  addressLine   String?   @db.VarChar(255)
  postalCode    String?   @db.VarChar(20)
  city          String?   @db.VarChar(100)
  locality      String?   @db.VarChar(100)
  province      String?   @db.VarChar(100)
  country       String?   @db.VarChar(100) @default("España")
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth.js relations
  accounts      Account[]
  sessions      Session[]

  // Domain relations
  favorites     Favorite[]
  orders        Order[]   // soft link — orders are also identified by email
  stockAlerts   StockAlert[]

  @@index([email])
}

/// OAuth account linked to a User (Auth.js adapter requirement)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Database session (Auth.js adapter requirement)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Email verification token (Auth.js adapter requirement)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Favorite product saved by a user
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

/// Stock alert subscription for out-of-stock products.
/// Supports authenticated users (userId) and guest users (email only).
model StockAlert {
  id          String             @id @default(cuid())
  productId   String
  userId      String?
  email       String             @db.VarChar(255)
  channel     NotificationChannel @default(EMAIL)
  status      NotificationStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  notifiedAt  DateTime?

  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([productId, email])
  @@unique([productId, userId])
  @@index([userId])
  @@index([email])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

/// Temporary persisted checkout cart for reliable webhook inventory updates.
model CheckoutSessionCart {
  id         String    @id @default(cuid())
  sessionId  String    @unique @db.VarChar(255)
  items      Json
  createdAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// B2B (Wholesale) Module
// ─────────────────────────────────────────────────────────────────────────────

enum B2bRequestStatus {
  PENDING     // Request submitted, waiting for admin review
  APPROVED    // Admin approved, customer created, activation email sent
  REJECTED    // Admin rejected the request
}

enum B2bCustomerStatus {
  PENDING     // Approved but hasn't set password yet
  ACTIVE      // Fully activated and can log in
  DISABLED    // Admin-disabled — auth succeeds but access is refused
}

enum B2bActivity {
  ONLINE_STORE
  VENDING_MACHINE
  PHYSICAL_STORE
  DISTRIBUTOR
  OTHER
}

enum B2bOrderStatus {
  PENDING     // Newly submitted, awaiting admin acceptance
  ACCEPTED    // Admin accepted → invoice generated, awaiting payment
  PAID        // Invoice paid → order will be prepared / shipped
  CANCELLED   // Cancelled by customer or admin (only while not yet PAID)
  REJECTED    // Admin rejected the request
}

/// A B2B account request submitted from the public site. Contains the email
/// captured at request time plus (optionally) the admin-collected company
/// documentation reviewed after the customer replies to the docs-request
/// email. When approved, a `B2bCustomer` row is created and this request is
/// marked APPROVED with a back-reference in `customerId`.
model B2bRequest {
  id                  String            @id @default(cuid())
  email               String            @db.VarChar(255)
  status              B2bRequestStatus  @default(PENDING)

  // Admin-collected documentation (all optional until Approve)
  companyName         String?           @db.VarChar(255)
  vatNumber           String?           @db.VarChar(64)
  modelo036Verified   Boolean           @default(false)
  activity            B2bActivity?
  activityOther       String?           @db.VarChar(255)
  shippingAddress     String?           @db.Text
  billingAddress      String?           @db.Text
  contactName         String?           @db.VarChar(255)
  nationalId          String?           @db.VarChar(64)  // DNI/NIE/Passport
  phone               String?           @db.VarChar(30)
  website             String?           @db.VarChar(500)
  estimatedVolume     String?           @db.VarChar(255)
  preferredLanguages  String?           @db.VarChar(255)
  notes               String?           @db.Text

  reviewedAt          DateTime?
  reviewedByEmail     String?           @db.VarChar(255)
  rejectionReason     String?           @db.Text

  customerId          String?           @unique  // Populated after APPROVED
  customer            B2bCustomer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

/// A B2B customer account. Sessions and activation tokens are related here.
/// `passwordHash` is null until the customer completes activation via the
/// emailed link. Only ACTIVE customers may access wholesale pricing.
model B2bCustomer {
  id                 String              @id @default(cuid())
  email              String              @unique @db.VarChar(255)
  passwordHash       String?             @db.VarChar(255)   // null until activation
  status             B2bCustomerStatus   @default(PENDING)

  // Snapshot of the approved company information (editable by admins).
  companyName        String              @db.VarChar(255)
  vatNumber          String              @db.VarChar(64)
  activity           B2bActivity
  activityOther      String?             @db.VarChar(255)
  shippingAddress    String              @db.Text
  billingAddress     String?             @db.Text
  contactName        String              @db.VarChar(255)
  nationalId         String?             @db.VarChar(64)
  phone              String              @db.VarChar(30)
  website            String?             @db.VarChar(500)
  estimatedVolume    String?             @db.VarChar(255)
  preferredLanguages String?             @db.VarChar(255)
  notes              String?             @db.Text

  lastLoginAt        DateTime?
  disabledAt         DateTime?
  activatedAt        DateTime?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  request            B2bRequest?
  sessions           B2bSession[]
  activationTokens   B2bActivationToken[]
  loginAudits        B2bLoginAudit[]
  orders             B2bOrder[]

  @@index([status])
  @@index([email])
  @@index([vatNumber])
}

/// A persistent B2B session token. The raw token lives only in the customer's
/// HttpOnly cookie; the DB stores a SHA-256 hash so a DB dump cannot be used
/// to forge sessions.
model B2bSession {
  id           String       @id @default(cuid())
  customerId   String
  tokenHash    String       @unique @db.VarChar(128)  // hex SHA-256 of the raw token
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  lastSeenAt   DateTime     @default(now())
  userAgent    String?      @db.VarChar(500)
  ipAddress    String?      @db.VarChar(64)

  customer     B2bCustomer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

/// One-time activation / password-reset token. Stored hashed. Expires after
/// a reasonable window (see B2B_ACTIVATION_TOKEN_TTL_HOURS in code).
model B2bActivationToken {
  id           String       @id @default(cuid())
  customerId   String
  tokenHash    String       @unique @db.VarChar(128)  // hex SHA-256 of the raw token
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime     @default(now())

  customer     B2bCustomer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

/// Login audit trail. Used to power rate limiting and give admins visibility
/// into unusual login patterns.
model B2bLoginAudit {
  id          String       @id @default(cuid())
  customerId  String?
  email       String       @db.VarChar(255)
  success     Boolean
  reason      String?      @db.VarChar(120)  // 'invalid_password', 'disabled', 'not_activated', 'ok', 'rate_limited', 'unknown_email'
  ipAddress   String?      @db.VarChar(64)
  userAgent   String?      @db.VarChar(500)
  createdAt   DateTime     @default(now())

  customer    B2bCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([customerId])
  @@index([createdAt])
}

/// A B2B (wholesale) order request.
///
/// Lifecycle:
///   PENDING   -> ACCEPTED (admin) -> PAID (admin, when the invoice is settled)
///             -> REJECTED (admin)
///             -> CANCELLED (customer or admin, only while status is
///                          PENDING or ACCEPTED -- PAID orders cannot be
///                          cancelled)
///
/// items is a JSON snapshot at request time so future price/name changes
/// don't rewrite historical invoices. Each element has the shape:
///   { productId, name, variant: 'SHRINK'|'NO_SHRINK', quantity, unitPriceEur, lineTotal }
///
/// Money columns are stored net of VAT:
///   - subtotal   = sum of line totals (pre-tax)
///   - ivaAmount  = 21% of subtotal (Spanish B2B rate)
///   - total      = subtotal + ivaAmount
///
/// Invoice numbers are generated on ACCEPTANCE and are legally required to
/// be sequential per Spanish tax law -- see getNextB2bInvoiceSequence() in
/// src/lib/b2b/order-numbers.ts (Sequence row with name = 'B2B_INVOICE').
model B2bOrder {
  id             String          @id @default(cuid())
  customerId     String
  orderNumber    String          @unique @db.VarChar(50)
  status         B2bOrderStatus  @default(PENDING)
  items          Json
  subtotal       Decimal         @db.Decimal(12, 2)
  ivaAmount      Decimal         @db.Decimal(12, 2)
  total          Decimal         @db.Decimal(12, 2)
  invoiceNumber  String?         @unique @db.VarChar(50)
  invoicedAt     DateTime?
  acceptedAt     DateTime?
  rejectedAt     DateTime?
  paidAt         DateTime?
  cancelledAt    DateTime?
  cancelledBy    String?         @db.VarChar(120)  // 'customer' | 'admin:<email>'
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  customer       B2bCustomer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}
