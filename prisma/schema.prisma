// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Language {
  JAPANESE
  KOREAN
  ENGLISH
  SPANISH
  CHINESE
}

enum OrderStatus {
  PROCESSING
  SHIPPED
  COMPLETED
  FAILED
  CANCELLED
  DEVUELTO
}

enum ShippingProvider {
  CORREOS
  MRW
  SEUR
  CTT_EXPRESS
}

enum PaymentStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
}

/// Customer's shipping-timing choice for an order, selected at checkout.
/// - IMMEDIATE: default behavior (shipping charged and fulfilled as soon as possible).
/// - GROUPED: customer explicitly chose "Agrupar Envío" — shipment is deferred so this
///   order can later be consolidated with future orders into a single physical shipment.
enum ShippingMode {
  IMMEDIATE
  GROUPED
}

enum PartyStatus {
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// - SHARED (Compartida): every participant keeps the packs they paid for.
/// - BATTLE (Batalla): the participant with the best hit wins every pack from the opening.
enum PartyMode {
  SHARED
  BATTLE
}

enum PartyParticipationStatus {
  PENDING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
  REFUND_REQUIRED
}

enum PartyRefundStatus {
  NONE
  REQUESTED
  REJECTED
  APPROVED
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  TELEGRAM
}

/// Product variant distinguishing between the sealed ("Sellado") version and the
/// live-opening ("Apertura en directo") version of the same underlying catalog
/// product, opened on stream at a lower price. Used to keep independent price
/// histories per variant (the left/right sections of the Google Sheets import).
enum ProductVariant {
  SEALED
  LIVE_OPENING
}

/// AnnouncementBanner model stores rotating announcement messages shown site-wide below the navigation.
/// Administrators manage banners from the Admin Panel (/admin/banners).
/// Only banners with enabled=true are served to the storefront.
/// Banners are displayed in ascending displayOrder order.
model AnnouncementBanner {
  id           String   @id @default(cuid())
  text         String   @db.VarChar(500)
  enabled      Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enabled])
  @@index([displayOrder])
}

/// Homepage hero slider item.
/// Only slides with isActive=true are served to the storefront, ordered by sortOrder asc.
/// sortOrder is normalized to 0..n-1 inside a transaction on every mutation.
/// name is internal (admin only) and is never exposed publicly.
model HeroSlide {
  id             String   @id @default(cuid())
  name           String   @db.VarChar(255)
  imageUrl       String   @db.VarChar(500)
  destinationUrl String   @db.VarChar(500)
  headline       String?  @db.VarChar(160)
  buttonLabel    String?  @db.VarChar(60)
  subtitle       String?  @db.VarChar(240)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// Product model represents a TCG/Pokemon card product in the catalog
/// Fields:
/// - id: Unique identifier (auto-generated CUID)
/// - name: Product name/title (max 255 chars)
/// - slug: URL-friendly identifier (unique, auto-generated from name)
/// - description: Detailed product description (text field for long content)
/// - price: Product price in EUR (decimal with 2 decimal places)
/// - stock: Number of units available (0 means sold out)
/// - imageUrl: S3 URL to product image (optional)
/// - priority: Display order in catalog (lower numbers appear first, default: 999)
/// - visible: Whether product appears on public catalog (default: true)
/// - createdAt: Timestamp when product was created (auto-set)
/// - updatedAt: Timestamp of last update (auto-updated)
/// - hitCards: Relationship to hit cards associated with this product
/// 
/// Indexes:
/// - visible: For filtering public products
/// - slug: For product detail page lookups
/// - priority: For ordering products by priority
/// 
/// Constraints:
/// - slug: UNIQUE to prevent duplicate URLs
model Product {
  id                   String   @id @default(cuid())
  name                 String   @db.VarChar(255)
  slug                 String   @unique @db.VarChar(255)
  description          String   @db.Text
  price                Decimal  @db.Decimal(10, 2)
  discountPercentage   Decimal? @db.Decimal(5, 2)
  /// Optional public price for the "Apertura en directo" (live-opening) variant.
  liveOpeningPrice     Decimal? @db.Decimal(10, 2)
  /// Optional wholesale price for authenticated B2B customers (SEALED variant only).
  /// When present, replaces the public `price` for logged-in active B2B users.
  b2bPrice             Decimal? @db.Decimal(10, 2)
  notes                String?  @db.Text
  type                 String?  @db.VarChar(100)
  releaseDate          DateTime?
  stock                Int      @default(0)
  imageUrl             String?  @db.VarChar(500)
  language             Language @default(ENGLISH)
  priority             Int      @default(999)
  visible              Boolean  @default(true)
  /// Physical weight of one unit in grams (nullable until populated by admin)
  weightGrams          Int?
  /// Physical length of one unit in centimeters (nullable until populated by admin)
  lengthCm             Decimal? @db.Decimal(8, 2)
  /// Physical width of one unit in centimeters (nullable until populated by admin)
  widthCm              Decimal? @db.Decimal(8, 2)
  /// Physical height of one unit in centimeters (nullable until populated by admin)
  heightCm             Decimal? @db.Decimal(8, 2)
  favoriteCount        Int      @default(0)  // denormalized counter — kept in sync via API transactions
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  hitCards             HitCard[]
  favorites            Favorite[]
  stockAlerts          StockAlert[]
  priceMappings        PriceMapping[]
  priceHistory         PriceHistory[]
  parties              Party[]

  @@index([visible])
  @@index([slug])
  @@index([language])
  @@index([priority])
  @@index([releaseDate])
  @@index([favoriteCount])  // supports sorting by popularity
  // NOTE: Additional Postgres-native indexes exist for the search feature and
  // are managed via raw SQL in migration `20260621223000_add_product_search_indexes`:
  //   - pg_trgm extension (required for substring ILIKE acceleration)
  //   - GIN trigram indexes on (name), (type) WHERE type IS NOT NULL, (description)
  //   - Composite B-tree (visible, priority) for the catalog access path
  // They are intentionally not declared here because Prisma's
  // postgresqlExtensions / ops preview features are not enabled.
}

/// PriceMapping stores permanent manual mappings from imported Google Sheets product
/// names to catalog product IDs. Once an administrator assigns a mapping, future imports
/// automatically resolve that name without requiring manual re-assignment.
model PriceMapping {
  id           String   @id @default(cuid())
  importedName String   @unique @db.VarChar(500)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([importedName])
  @@index([productId])
}

/// PriceHistory records the imported purchase price (converted JPY → EUR, before margin)
/// for every imported sheet product on each import day, regardless of whether the imported
/// row was matched to a catalog product. Independent histories are kept per product
/// variant (SEALED / LIVE_OPENING), so the Sealed and Live-Opening versions of the same
/// product never share data points.
///
/// Deduplication:
/// - A UNIQUE (sheetProductName, variant, importDate) constraint guarantees at most one
///   record per imported-name/variant/day. Multiple imports on the same calendar day
///   upsert the existing row so the "last import of the day wins".
///
/// Historical-minimum lookups:
/// - The composite index on (sheetProductName, variant, purchasePriceEur) supports
///   fast MIN() queries used to detect when today's price is the all-time low.
///
/// Chart queries:
/// - The (sheetProductName, variant, importDate) index supports ordered range scans
///   used by the historical price chart.
///
/// Catalog association:
/// - `catalogProductId` is optional. When an imported name is (or was) mapped to a
///   catalog product, the FK is populated so admins can trace history back. If the
///   catalog product is later deleted, the FK is set to NULL so the historical series
///   remains intact.
model PriceHistory {
  id                String         @id @default(cuid())
  catalogProductId  String?
  variant           ProductVariant
  sheetProductName  String         @db.VarChar(500)
  importDate        DateTime       @db.Date
  importTimestamp   DateTime       @default(now())
  priceJpy          Decimal        @db.Decimal(12, 2)
  exchangeRate      Decimal        @db.Decimal(18, 10)
  purchasePriceEur  Decimal        @db.Decimal(12, 4)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  catalogProduct    Product?       @relation(fields: [catalogProductId], references: [id], onDelete: SetNull)

  @@unique([sheetProductName, variant, importDate])
  @@index([sheetProductName, variant, importDate])
  @@index([sheetProductName, variant, purchasePriceEur])
  @@index([catalogProductId])
}

/// HitCard model represents promotional/best hit cards associated with a product
/// Fields:
/// - id: Unique identifier (auto-generated CUID)
/// - productId: Foreign key reference to Product
/// - product: Relationship to the Product
/// - name: Hit card name/title (max 255 chars)
/// - type: Type of hit card (string field for flexibility)
/// - imageUrl: Supabase storage URL to hit card image
/// - marketPrice: Market price of the hit card in EUR (decimal with 2 decimal places)
/// - createdAt: Timestamp when hit card was created (auto-set)
/// - updatedAt: Timestamp of last update (auto-updated)
/// 
/// Indexes:
/// - productId: For filtering hit cards by product
/// 
/// Constraints:
/// - productId: Foreign key to Product, cascade delete
model HitCard {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String   @db.VarChar(255)
  type          String   @db.VarChar(100)
  imageUrl      String   @db.VarChar(500)
  marketPrice   Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
}

/// Order model represents a customer order
/// Fields:
/// - id: Unique identifier (auto-generated CUID)
/// - orderNumber: Customer-facing order number (TCG-YYYYMMDD-000000 format)
/// - redsysOrderId: Numeric Redsys order ID for payment gateway (unique)
/// - paymentProvider: Payment provider used (stripe, redsys, etc.)
/// - paymentStatus: Payment status (PENDING_PAYMENT, PAID, PAYMENT_FAILED, CANCELLED)
/// - fullName: Customer's full name
/// - email: Customer's email address
/// - phone: Customer's phone number
/// - shippingAddress: Street address
/// - shippingPostalCode: Postal/ZIP code
/// - shippingCity: City name
/// - shippingLocality: Locality/Region
/// - shippingProvince: Province/State
/// - totalAmount: Total order amount in EUR
/// - status: Order fulfillment status (PROCESSING, COMPLETED, FAILED, CANCELLED)
/// - stripeSessionId: Stripe checkout session ID for payment tracking (deprecated, legacy)
/// - redsysTransactionId: Redsys transaction reference ID (Ds_Reference)
/// - redsysResponseCode: Redsys response code (Ds_Response)
/// - redsysAuthCode: Redsys authorization code (Ds_AuthorisationCode)
/// - paymentAmount: Amount actually charged (for reconciliation)
/// - paymentCurrency: Currency code (should be EUR)
/// - paymentPaidAt: Timestamp when payment was confirmed
/// - items: JSON array of ordered items
/// - createdAt: Timestamp when order was created
/// - updatedAt: Timestamp of last update
/// 
/// Indexes:
/// - email: For finding orders by customer email
/// - status: For filtering orders by fulfillment status
/// - paymentStatus: For filtering orders by payment status
/// - stripeSessionId: For finding legacy Stripe orders
/// - redsysOrderId: For finding Redsys orders
model Order {
  id                    String           @id @default(cuid())
  orderNumber           String           @unique @db.VarChar(50)
  redsysOrderId         String?          @unique @db.VarChar(12)  // Numeric Redsys order ID
  paymentProvider       String           @default("redsys") @db.VarChar(50)  // "stripe" | "redsys"
  paymentStatus         PaymentStatus    @default(PENDING_PAYMENT)  // PENDING_PAYMENT, PAID, PAYMENT_FAILED, CANCELLED
  /// Client-generated id (persisted in localStorage) identifying the shopping cart that
  /// produced this order. Lets retried/abandoned checkout attempts for the same cart
  /// reuse this row instead of creating a duplicate order — see /api/payments/redsys/create.
  /// Null for legacy orders created before this field existed.
  cartId                String?     @db.VarChar(100)
  userId                String?     // nullable – guest orders have no userId
  fullName              String      @db.VarChar(255)
  email                 String      @db.VarChar(255)
  phone                 String      @db.VarChar(20)
  shippingAddress       String      @db.Text
  shippingPostalCode    String      @db.VarChar(20)
  shippingCity          String      @db.VarChar(255)
  shippingLocality      String      @db.VarChar(255)
  shippingProvince      String      @db.VarChar(255)
  totalAmount           Decimal     @db.Decimal(12, 2)
  status                OrderStatus @default(PROCESSING)  // Fulfillment status: PROCESSING, SHIPPED, COMPLETED, FAILED, CANCELLED
  shippingProvider      ShippingProvider?  // Shipping provider when status is SHIPPED
  trackingNumber        String?     @db.VarChar(100)  // Tracking number when status is SHIPPED
  shippedAt             DateTime?   // When the order was marked as shipped
  /// "Agrupar Envío": customer's checkout choice to defer this order's shipment so it can
  /// later be consolidated with other orders into a single shipment. Defaults to IMMEDIATE
  /// so all historical/existing orders keep their current behavior unchanged.
  shippingMode          ShippingMode @default(IMMEDIATE)
  /// Set once the customer requests shipment (alone or consolidated) and this order is
  /// atomically claimed into a Shipment. Null while GROUPED and still awaiting a request.
  shipmentId            String?
  shipment              Shipment?   @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  partyParticipation    PartyParticipation?
  stripeSessionId       String?     @unique @db.VarChar(500)  // @deprecated: Legacy Stripe field
  redsysTransactionId   String?     @db.VarChar(50)  // Ds_Reference from Redsys
  redsysResponseCode    String?     @db.VarChar(10)  // Ds_Response from Redsys
  redsysAuthCode        String?     @db.VarChar(50)  // Ds_AuthorisationCode from Redsys
  paymentAmount         Decimal?    @db.Decimal(12, 2)  // Amount charged (for reconciliation)
  paymentCurrency       String?     @db.VarChar(3)  // EUR
  paymentPaidAt         DateTime?   // When payment was confirmed
  items                 Json        // Array of {productId, name, quantity, price, discountPercentage}
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  loyaltyReward         LoyaltyOrderReward?
  loyaltyPurchase       LoyaltyPurchase?
  loyaltyRedemption     LoyaltyRedemption?
  loyaltyTransactions   LoyaltyTransaction[]
  loyaltyRefunds        LoyaltyRefund[]

  @@index([email])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([redsysOrderId])
  @@index([shippingMode])
  @@index([shipmentId])
  @@index([cartId])
}

/// Represents a single consolidated physical shipment covering one or more grouped
/// ("Agrupar Envío") orders belonging to the SAME customer and SAME shipping address.
///
/// Lifecycle:
///   Customer requests shipment (alone or consolidating several eligible orders)
///     -> shippingCost computed once from combined merchandise value (reuses the
///        existing weight/threshold shipping calculator — no new pricing logic)
///     -> if shippingCost > 0: a single Redsys payment is created for that fee
///        (paymentStatus starts PENDING_PAYMENT); if shippingCost is 0 (free-shipping
///        threshold reached) paymentStatus is set to PAID immediately, no payment step
///     -> once paymentStatus is PAID, admin ships the group like any other order
///        (existing Order.status/shippingProvider/trackingNumber fields are reused —
///        see admin orders PATCH, which cascades SHIPPED to every order in the group)
///
/// This design deliberately reuses the existing `PaymentStatus` enum instead of adding
/// a parallel status enum, and reuses `Order`'s own carrier/tracking fields instead of
/// duplicating shipment tracking. Orders are atomically claimed via a guarded
/// updateMany (shipmentId IS NULL) inside the same transaction that creates this row,
/// which prevents two concurrent requests from creating duplicate shipments for the
/// same orders.
model Shipment {
  id                  String        @id @default(cuid())
  shipmentNumber      String        @unique @db.VarChar(50)   // customer-facing: ENV-YYYYMMDD-000000
  userId              String
  /// Snapshot of the combined merchandise subtotal of all included orders at request time.
  merchandiseTotal    Decimal       @db.Decimal(12, 2)
  /// The single shipping fee for the whole consolidated shipment (0 when combined value
  /// reaches the existing free-shipping threshold).
  shippingCost        Decimal       @db.Decimal(12, 2) @default(0)
  paymentProvider     String?       @db.VarChar(50)  // "redsys", null when shippingCost = 0 (no payment needed)
  paymentStatus       PaymentStatus @default(PAID)    // PAID immediately when shippingCost = 0
  redsysOrderId       String?       @unique @db.VarChar(12)
  redsysTransactionId String?       @db.VarChar(50)
  redsysResponseCode  String?       @db.VarChar(10)
  redsysAuthCode      String?       @db.VarChar(50)
  paymentPaidAt       DateTime?
  requestedAt         DateTime      @default(now())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders              Order[]

  @@index([userId])
  @@index([paymentStatus])
}

model Party {
  id                    String      @id @default(cuid())
  productId             String
  boxPrice              Decimal     @db.Decimal(10, 2)
  packsPerBox           Int
  participantCount      Int
  packsPerParticipant   Int
  participationPrice    Decimal     @db.Decimal(10, 2)
  status                PartyStatus @default(OPEN)
  mode                  PartyMode   @default(BATTLE)
  internalNotes         String?     @db.Text
  tiktokLiveUrl         String?     @db.VarChar(500)
  startedAt             DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  inventoryReleased     Boolean     @default(false)
  createdByAdminId      String?     @db.VarChar(255)
  winnerParticipationId String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  product               Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  participations        PartyParticipation[]  @relation("PartyParticipations")
  winnerParticipation   PartyParticipation?   @relation("PartyWinner", fields: [winnerParticipationId], references: [id], onDelete: SetNull)
  auditLogs             PartyAuditLog[]

  @@index([status, createdAt])
  @@index([productId])
}

model PartyParticipation {
  id                      String                   @id @default(cuid())
  partyId                 String
  userId                  String
  slotNumber              Int?
  status                  PartyParticipationStatus @default(PENDING_PAYMENT)
  refundStatus            PartyRefundStatus         @default(NONE)
  amountPaid              Decimal                  @db.Decimal(10, 2)
  /// Legacy Stripe references retained for reconciliation of previously created sessions.
  stripeCheckoutSessionId String?                  @unique @db.VarChar(255)
  stripePaymentIntentId   String?                  @unique @db.VarChar(255)
  redsysOrderId           String?                  @unique @db.VarChar(12)
  redsysTransactionId     String?                  @db.VarChar(50)
  orderId                 String?                  @unique
  reservedAt              DateTime                 @default(now())
  reservationExpiresAt    DateTime?
  paidAt                  DateTime?
  refundedAt              DateTime?
  shippingRequestedAt     DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  party      Party  @relation("PartyParticipations", fields: [partyId], references: [id], onDelete: Cascade)
  user       User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order      Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  wonParty   Party? @relation("PartyWinner")

  @@unique([partyId, slotNumber])
  @@index([partyId, status])
  @@index([userId, partyId])
  @@index([reservationExpiresAt])
}

model PartyAuditLog {
  id        String   @id @default(cuid())
  partyId   String
  action    String   @db.VarChar(100)
  adminId   String?  @db.VarChar(255)
  details   Json?
  createdAt DateTime @default(now())

  party     Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId, createdAt])
}

/// Sequence model represents a sequence for auto-incrementing IDs
/// Fields:
/// - name: ORDER
/// - value: incrementing value
enum LotteryStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  FINISHED
  DRAWN
  CANCELLED
}

enum LotteryParticipationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LotteryPurchasePlatform {
  TIKTOK
  WEBSITE
}

enum LotteryRejectionReason {
  INVALID_ORDER_DATE
  MINIMUM_AMOUNT_NOT_MET
  ORDER_NOT_FOUND
  OTHER
}

model Lottery {
  id                    String        @id @default(cuid())
  title                 String        @db.VarChar(160)
  slug                  String        @unique @db.VarChar(180)
  prize                 String        @db.VarChar(255)
  prizeImageUrl         String?       @db.VarChar(500)
  description           String        @db.Text
  startDate             DateTime
  endDate               DateTime
  minimumOrderAmount    Decimal?      @db.Decimal(10, 2)
  status                LotteryStatus @default(DRAFT)
  createdById           String        @db.VarChar(255)
  finishedAt            DateTime?
  drawnAt               DateTime?
  drawnById             String?       @db.VarChar(255)
  eligibleCountAtDraw   Int?
  winnerParticipationId String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  participations      LotteryParticipation[] @relation("LotteryParticipations")
  winnerParticipation LotteryParticipation?  @relation("LotteryWinner", fields: [winnerParticipationId], references: [id], onDelete: SetNull)
  auditLogs           LotteryAuditLog[]

  @@index([status, startDate])
  @@index([status, endDate])
}

model LotteryParticipation {
  id                    String                     @id @default(cuid())
  lotteryId             String
  userId                String
  userEmailSnapshot     String                     @db.VarChar(255)
  orderNumber           String                     @db.VarChar(50)
  normalizedOrderNumber String                     @db.VarChar(50)
  platform              LotteryPurchasePlatform
  tiktokUsername        String?                    @db.VarChar(60)
  orderDate             DateTime                   @db.Date
  status                LotteryParticipationStatus @default(PENDING)
  rejectionReason       LotteryRejectionReason?
  rejectionReasonDetails String?                   @db.VarChar(500)
  reviewedById          String?                    @db.VarChar(255)
  reviewedAt            DateTime?
  submittedAt           DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  lottery      Lottery  @relation("LotteryParticipations", fields: [lotteryId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  wonLottery   Lottery? @relation("LotteryWinner")

  @@unique([lotteryId, normalizedOrderNumber])
  @@index([lotteryId, status])
  @@index([userId])
  @@index([orderNumber])
}

model LotteryAuditLog {
  id              String   @id @default(cuid())
  lotteryId       String
  participationId String?  @db.VarChar(255)
  action          String   @db.VarChar(100)
  adminId         String?  @db.VarChar(255)
  details         Json?
  createdAt       DateTime @default(now())

  lottery Lottery @relation(fields: [lotteryId], references: [id], onDelete: Cascade)

  @@index([lotteryId, createdAt])
}

model Sequence {
  name                  String      @id
  value                 Int
}

// ─── Auth.js / NextAuth v5 required models ───────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

/// Customer / authenticated user account.
/// Supports both local (email + bcrypt password) and OAuth (Google) sign-in.
model User {
  id            String    @id @default(cuid())
  email         String    @unique @db.VarChar(255)
  emailVerified DateTime?
  passwordHash  String?   @db.VarChar(255)  // null for OAuth-only accounts
  fullName      String?   @db.VarChar(255)
  image         String?   @db.VarChar(500)  // OAuth profile picture
  phone         String?   @db.VarChar(30)
  addressLine   String?   @db.VarChar(255)
  postalCode    String?   @db.VarChar(20)
  city          String?   @db.VarChar(100)
  locality      String?   @db.VarChar(100)
  province      String?   @db.VarChar(100)
  country       String?   @db.VarChar(100) @default("España")
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth.js relations
  accounts      Account[]
  sessions      Session[]

  // Domain relations
  favorites     Favorite[]
  orders        Order[]   // soft link — orders are also identified by email
  stockAlerts   StockAlert[]
  shipments     Shipment[]
  partyParticipations PartyParticipation[]
  lotteryParticipations LotteryParticipation[]
  loyaltyAccount LoyaltyAccount?
  loyaltyPurchases LoyaltyPurchase[]
  loyaltyAdminTransactions LoyaltyTransaction[] @relation("LoyaltyAdminTransactions")
  loyaltyAdminRefunds LoyaltyRefund[] @relation("LoyaltyAdminRefunds")
  loyaltyAdminActions LoyaltyAdminAction[]

  @@index([email])
}

enum LoyaltyTransactionType {
  PURCHASE_REWARD
  REDEMPTION
  REFUND_REVERSAL
  REDEMPTION_RESTORE
  ADMIN_ADJUSTMENT
  EXPIRATION
  PROMOTIONAL_BONUS
}

enum LoyaltyRedemptionStatus {
  RESERVED
  SETTLED
  RELEASED
}

/// Disabled until the payment, refund and reservation lifecycle is integrated.
model LoyaltyProgramConfig {
  id                    String        @id @default("default")
  enabled               Boolean       @default(false)
  baseRate              Decimal       @default(1) @db.Decimal(10, 4)
  pointsPerEuro         Decimal       @default(100) @db.Decimal(12, 2)
  minimumRedemption     Decimal       @default(100) @db.Decimal(12, 2)
  redemptionIncrement   Decimal       @default(100) @db.Decimal(12, 2)
  maxDiscountPercent    Decimal       @default(20) @db.Decimal(5, 2)
  evaluationDays        Int           @default(60)
  expirationMonths      Int           @default(12)
  updatedAt             DateTime      @updatedAt
  tiers                 LoyaltyTier[]
}

model LoyaltyTier {
  id          String               @id @default(cuid())
  configId    String               @default("default")
  name        String               @db.VarChar(100)
  position    Int
  threshold   Decimal              @db.Decimal(12, 2)
  multiplier  Decimal              @db.Decimal(10, 4)
  description String               @default("") @db.Text
  color       String               @default("#D4AF37") @db.VarChar(32)
  icon        String               @default("") @db.VarChar(100)
  benefits    Json                 @default("[]")
  config      LoyaltyProgramConfig @relation(fields: [configId], references: [id], onDelete: Restrict)

  @@unique([configId, position])
  @@unique([configId, name])
}

/// The signed balance is the sum of ledger transactions; negative means debt.
model LoyaltyAccount {
  id           String               @id @default(cuid())
  userId       String               @unique
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  /// Set once the 60-day historical points migration has been executed.
  historicalBackfillAt DateTime?
  historicalBackfillBy String?
  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions LoyaltyTransaction[]
  lots         LoyaltyPointsLot[]
  rewards      LoyaltyOrderReward[]
  redemptions  LoyaltyRedemption[]
}

/// Immutable checkout amounts and authenticated customer attribution.
model LoyaltyPurchase {
  id            String  @id @default(cuid())
  orderId       String  @unique
  userId        String
  productGross  Decimal @db.Decimal(12, 2)
  eligibleSpend Decimal @db.Decimal(12, 2)
  shippingGross Decimal @db.Decimal(12, 2)
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user          User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

/// Append-only. Corrections are recorded as separate compensating transactions.
model LoyaltyTransaction {
  id                String                 @id @default(cuid())
  sequence          BigInt                 @unique @default(autoincrement())
  accountId         String
  orderId           String?
  actorId           String?
  adminActor        String?
  type              LoyaltyTransactionType
  points            Decimal                @db.Decimal(16, 2)
  balanceAfter      Decimal                @db.Decimal(16, 2)
  description       String                 @db.Text
  idempotencyKey    String                 @unique @db.VarChar(255)
  multiplier        Decimal?               @db.Decimal(10, 4)
  eligibleSpend     Decimal?               @db.Decimal(12, 2)
  expiresAt         DateTime?
  createdAt         DateTime               @default(now())
  account           LoyaltyAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order             Order?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor             User?                  @relation("LoyaltyAdminTransactions", fields: [actorId], references: [id], onDelete: Restrict)
  lot               LoyaltyPointsLot?
  allocations       LoyaltyLotAllocation[]

  @@index([accountId, createdAt, id])
  @@index([accountId, sequence])
  @@index([orderId])
  @@index([actorId])
}

model LoyaltyPointsLot {
  id             String                @id @default(cuid())
  accountId      String
  transactionId  String                @unique
  originalPoints Decimal               @db.Decimal(16, 2)
  remainingPoints Decimal              @db.Decimal(16, 2)
  expiresAt      DateTime?
  createdAt      DateTime              @default(now())
  account        LoyaltyAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transaction    LoyaltyTransaction    @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  allocations    LoyaltyLotAllocation[]

  @@index([accountId, expiresAt, createdAt])
}

model LoyaltyOrderReward {
  id                  String         @id @default(cuid())
  orderId             String         @unique
  accountId           String
  tierName            String         @db.VarChar(100)
  multiplier          Decimal        @db.Decimal(10, 4)
  baseRate            Decimal        @db.Decimal(10, 4)
  eligibleSpend       Decimal        @db.Decimal(12, 2)
  refundedSpend       Decimal        @default(0) @db.Decimal(12, 2)
  pointsEarned        Decimal        @db.Decimal(16, 2)
  pointsReversed      Decimal        @default(0) @db.Decimal(16, 2)
  paidAt              DateTime
  createdAt           DateTime       @default(now())
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  account             LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, paidAt])
}

model LoyaltyRedemption {
  id              String                  @id @default(cuid())
  orderId         String                  @unique
  accountId       String
  status          LoyaltyRedemptionStatus @default(RESERVED)
  points          Decimal                 @db.Decimal(16, 2)
  discountNet     Decimal                 @db.Decimal(12, 2)
  discountGross   Decimal                 @db.Decimal(12, 2)
  pointsRestored  Decimal                 @default(0) @db.Decimal(16, 2)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  order           Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  account         LoyaltyAccount          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  allocations     LoyaltyLotAllocation[]

  @@index([accountId, status])
}

model LoyaltyLotAllocation {
  id            String            @id @default(cuid())
  lotId         String
  redemptionId  String?
  transactionId String?
  points        Decimal           @db.Decimal(16, 2)
  lot           LoyaltyPointsLot  @relation(fields: [lotId], references: [id], onDelete: Restrict)
  redemption    LoyaltyRedemption? @relation(fields: [redemptionId], references: [id], onDelete: Restrict)
  transaction   LoyaltyTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([lotId, redemptionId])
  @@unique([lotId, transactionId])
  @@index([redemptionId])
  @@index([transactionId])
}

/// Records externally confirmed refunds; it does not initiate a bank refund.
model LoyaltyRefund {
  id                String   @id @default(cuid())
  orderId           String
  actorId           String
  externalReference String   @unique @db.VarChar(255)
  reason            String   @db.Text
  eligibleSpend     Decimal  @db.Decimal(12, 2)
  pointsReversed    Decimal  @db.Decimal(16, 2)
  pointsRestored    Decimal  @db.Decimal(16, 2)
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor             User     @relation("LoyaltyAdminRefunds", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([actorId])
}

model LoyaltyAdminAction {
  id         String   @id @default(cuid())
  actorId    String?
  adminActor String?
  action     String   @db.VarChar(100)
  reason     String   @db.Text
  before     Json
  after      Json
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
}

/// OAuth account linked to a User (Auth.js adapter requirement)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Database session (Auth.js adapter requirement)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Email verification token (Auth.js adapter requirement)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Favorite product saved by a user
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

/// Stock alert subscription for out-of-stock products.
/// Supports authenticated users (userId) and guest users (email only).
model StockAlert {
  id          String             @id @default(cuid())
  productId   String
  userId      String?
  email       String             @db.VarChar(255)
  channel     NotificationChannel @default(EMAIL)
  status      NotificationStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  notifiedAt  DateTime?

  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([productId, email])
  @@unique([productId, userId])
  @@index([userId])
  @@index([email])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

/// Temporary persisted checkout cart for reliable webhook inventory updates.
model CheckoutSessionCart {
  id         String    @id @default(cuid())
  sessionId  String    @unique @db.VarChar(255)
  items      Json
  createdAt  DateTime  @default(now())
  processedAt DateTime?
  inventoryConflictAt DateTime?

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// B2B (Wholesale) Module
// ─────────────────────────────────────────────────────────────────────────────

enum B2bRequestStatus {
  PENDING     // Request submitted, waiting for admin review
  APPROVED    // Admin approved, customer created, activation email sent
  REJECTED    // Admin rejected the request
}

enum B2bCustomerStatus {
  PENDING     // Approved but hasn't set password yet
  ACTIVE      // Fully activated and can log in
  DISABLED    // Admin-disabled — auth succeeds but access is refused
}

enum B2bActivity {
  ONLINE_STORE
  VENDING_MACHINE
  PHYSICAL_STORE
  DISTRIBUTOR
  OTHER
}

/// Order LIFECYCLE only. Payment, fulfillment and documents are tracked by
/// their own independent fields (see B2bPaymentStatus / B2bFulfillmentStatus /
/// B2bDocument). The legacy PAID value was migrated to paymentStatus = PAID.
enum B2bOrderStatus {
  PENDING     // Customer request (or admin quotation) awaiting confirmation
  ACCEPTED    // Confirmed order
  CANCELLED   // Cancelled by customer or admin
  REJECTED    // Admin rejected the request
}

enum B2bPaymentStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum B2bFulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum B2bOrderSource {
  CUSTOMER
  ADMIN
}

/// INVOICE and CORRECTIVE_INVOICE are legally issued documents with their own
/// gap-free number series. PROFORMA and QUOTATION are preliminary documents
/// with no fiscal value.
enum B2bDocumentType {
  INVOICE
  PROFORMA
  QUOTATION
  CORRECTIVE_INVOICE
}

enum B2bDocumentStatus {
  GENERATING
  ISSUED
  FAILED
}

enum B2bOrderEventType {
  ORDER_CREATED
  ORDER_CREATED_BY_ADMIN
  ORDER_ACCEPTED
  ORDER_REJECTED
  ORDER_UPDATED
  ORDER_CANCELLED
  PAYMENT_STATUS_CHANGED
  FULFILLMENT_STATUS_CHANGED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_RETURNED
  TRACKING_UPDATED
  CARRIER_CHANGED
  ADMIN_NOTE_UPDATED
  CUSTOMER_NOTE_UPDATED
  DOCUMENT_GENERATED
  DOCUMENT_GENERATION_FAILED
  DOCUMENT_GENERATION_RETRIED
  DOCUMENT_EMAIL_SENT
  DOCUMENT_EMAIL_FAILED
  SHIPPING_EMAIL_SENT
  SHIPPING_EMAIL_FAILED
  SHIPPING_EMAIL_RETRIED
}

/// A B2B account request submitted from the public site. Contains the email
/// captured at request time plus (optionally) the admin-collected company
/// documentation reviewed after the customer replies to the docs-request
/// email. When approved, a `B2bCustomer` row is created and this request is
/// marked APPROVED with a back-reference in `customerId`.
model B2bRequest {
  id                  String            @id @default(cuid())
  email               String            @db.VarChar(255)
  status              B2bRequestStatus  @default(PENDING)

  // Admin-collected documentation (all optional until Approve)
  companyName         String?           @db.VarChar(255)
  vatNumber           String?           @db.VarChar(64)
  modelo036Verified   Boolean           @default(false)
  activity            B2bActivity?
  activityOther       String?           @db.VarChar(255)
  shippingAddress     String?           @db.Text
  billingAddress      String?           @db.Text
  contactName         String?           @db.VarChar(255)
  nationalId          String?           @db.VarChar(64)  // DNI/NIE/Passport
  phone               String?           @db.VarChar(30)
  website             String?           @db.VarChar(500)
  estimatedVolume     String?           @db.VarChar(255)
  preferredLanguages  String?           @db.VarChar(255)
  notes               String?           @db.Text
  /// "Recargo de Equivalencia" regime, copied to the customer on approval.
  equivalenceSurcharge Boolean          @default(false)

  reviewedAt          DateTime?
  reviewedByEmail     String?           @db.VarChar(255)
  rejectionReason     String?           @db.Text

  customerId          String?           @unique  // Populated after APPROVED
  customer            B2bCustomer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

/// A B2B customer account. Sessions and activation tokens are related here.
/// `passwordHash` is null until the customer completes activation via the
/// emailed link. Only ACTIVE customers may access wholesale pricing.
model B2bCustomer {
  id                 String              @id @default(cuid())
  email              String              @unique @db.VarChar(255)
  passwordHash       String?             @db.VarChar(255)   // null until activation
  status             B2bCustomerStatus   @default(PENDING)

  // Snapshot of the approved company information (editable by admins).
  companyName        String              @db.VarChar(255)
  vatNumber          String              @db.VarChar(64)
  activity           B2bActivity
  activityOther      String?             @db.VarChar(255)
  shippingAddress    String              @db.Text
  billingAddress     String?             @db.Text
  contactName        String              @db.VarChar(255)
  nationalId         String?             @db.VarChar(64)
  phone              String              @db.VarChar(30)
  website            String?             @db.VarChar(500)
  estimatedVolume    String?             @db.VarChar(255)
  preferredLanguages String?             @db.VarChar(255)
  notes              String?             @db.Text
  /// Customer taxed under the Spanish "Recargo de Equivalencia" regime: new
  /// orders add B2B_EQUIVALENCE_SURCHARGE_RATE (5.2%) on the taxable base.
  equivalenceSurcharge Boolean           @default(false)

  lastLoginAt        DateTime?
  disabledAt         DateTime?
  activatedAt        DateTime?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  request            B2bRequest?
  sessions           B2bSession[]
  activationTokens   B2bActivationToken[]
  loginAudits        B2bLoginAudit[]
  orders             B2bOrder[]
  documents          B2bDocument[]

  @@index([status])
  @@index([email])
  @@index([vatNumber])
}

/// A persistent B2B session token. The raw token lives only in the customer's
/// HttpOnly cookie; the DB stores a SHA-256 hash so a DB dump cannot be used
/// to forge sessions.
model B2bSession {
  id           String       @id @default(cuid())
  customerId   String
  tokenHash    String       @unique @db.VarChar(128)  // hex SHA-256 of the raw token
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  lastSeenAt   DateTime     @default(now())
  userAgent    String?      @db.VarChar(500)
  ipAddress    String?      @db.VarChar(64)

  customer     B2bCustomer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

/// One-time activation / password-reset token. Stored hashed. Expires after
/// a reasonable window (see B2B_ACTIVATION_TOKEN_TTL_HOURS in code).
model B2bActivationToken {
  id           String       @id @default(cuid())
  customerId   String
  tokenHash    String       @unique @db.VarChar(128)  // hex SHA-256 of the raw token
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime     @default(now())

  customer     B2bCustomer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

/// Login audit trail. Used to power rate limiting and give admins visibility
/// into unusual login patterns.
model B2bLoginAudit {
  id          String       @id @default(cuid())
  customerId  String?
  email       String       @db.VarChar(255)
  success     Boolean
  reason      String?      @db.VarChar(120)  // 'invalid_password', 'disabled', 'not_activated', 'ok', 'rate_limited', 'unknown_email'
  ipAddress   String?      @db.VarChar(64)
  userAgent   String?      @db.VarChar(500)
  createdAt   DateTime     @default(now())

  customer    B2bCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([customerId])
  @@index([createdAt])
}

/// A B2B (wholesale) order — submitted by the customer from the cart
/// (source = CUSTOMER) or created manually by an admin (source = ADMIN).
///
/// Status dimensions are INDEPENDENT (see src/lib/b2b/order-status.ts):
///   status            order lifecycle   PENDING -> ACCEPTED | REJECTED | CANCELLED
///   paymentStatus     money             PENDING -> PAID -> REFUNDED, PENDING -> CANCELLED
///   fulfillmentStatus logistics         PENDING -> PROCESSING -> SHIPPED -> DELIVERED -> RETURNED
///   documents         invoices / proformas / quotations (B2bDocument rows)
///
/// `items` is an immutable JSON snapshot (B2bOrderLineSnapshot in src/types):
///   { productId, name, sku, language, variant, imageUrl, quantity,
///     listUnitPriceEur, discountPercent, discountAmountEur, unitPriceEur,
///     vatRate, lineTotal }
/// Legacy rows only carry { productId, name, quantity, unitPriceEur, lineTotal }.
///
/// Money columns are net of VAT:
///   subtotal      = sum of line totals (after line discounts)
///   discountTotal = sum of line discounts (informative)
///   shippingCost  = shipping, net (taxed at vatRate)
///   ivaAmount     = (subtotal + shippingCost) * vatRate
///   surchargeAmount = (subtotal + shippingCost) * surchargeRate   (Recargo de Equivalencia, 0 if N/A)
///   total         = subtotal + shippingCost + ivaAmount + surchargeAmount
model B2bOrder {
  id                  String               @id @default(cuid())
  customerId          String
  orderNumber         String               @unique @db.VarChar(50)
  source              B2bOrderSource       @default(CUSTOMER)
  status              B2bOrderStatus       @default(PENDING)
  paymentStatus       B2bPaymentStatus     @default(PENDING)
  fulfillmentStatus   B2bFulfillmentStatus @default(PENDING)
  items               Json
  /// Snapshot of the customer's company / addresses when the order was placed.
  customerSnapshot    Json
  vatRate             Decimal              @default(0.21) @db.Decimal(5, 4)
  subtotal            Decimal              @db.Decimal(12, 2)
  discountTotal       Decimal              @default(0) @db.Decimal(12, 2)
  shippingCost        Decimal              @default(0) @db.Decimal(12, 2)
  ivaAmount           Decimal              @db.Decimal(12, 2)
  /// Recargo de Equivalencia frozen at order creation (0 when not applicable).
  surchargeRate       Decimal              @default(0) @db.Decimal(5, 4)
  surchargeAmount     Decimal              @default(0) @db.Decimal(12, 2)
  total               Decimal              @db.Decimal(12, 2)

  acceptedAt          DateTime?
  rejectedAt          DateTime?
  cancelledAt         DateTime?
  cancelledBy         String?              @db.VarChar(120)  // 'customer' | 'admin:<email>'
  cancellationReason  String?              @db.Text

  paidAt              DateTime?
  paymentMethod       String?              @db.VarChar(60)
  paymentReference    String?              @db.VarChar(120)
  refundedAt          DateTime?

  shippingProvider    ShippingProvider?
  trackingNumber      String?              @db.VarChar(100)
  processingAt        DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  returnedAt          DateTime?
  returnReason        String?              @db.Text
  shippingEmailSentAt DateTime?
  shippingEmailError  String?              @db.VarChar(500)

  /// Customer-visible notes (customer request notes or admin-written notes).
  notes               String?              @db.Text
  /// Internal notes — NEVER serialised to B2B customers.
  internalNotes       String?              @db.Text
  createdBy           String?              @db.VarChar(120)  // 'customer' | 'admin:<email>'
  /// Client-generated key that makes order creation retry-safe.
  idempotencyKey      String?              @unique @db.VarChar(100)

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  customer            B2bCustomer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  documents           B2bDocument[]
  events              B2bOrderEvent[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([source])
  @@index([createdAt])
  @@index([total])
}

/// A generated commercial document (PDF stored in the PRIVATE R2 bucket
/// `R2_B2B_INVOICES_BUCKET`). Once ISSUED a document is immutable: its PDF is
/// never regenerated or overwritten. Corrections are made through a
/// CORRECTIVE_INVOICE pointing at the original via `correctsDocumentId`.
///
/// `payload` freezes exactly what is rendered (order snapshot + customer
/// fiscal data at issue time) so retries render identical content.
/// `uniquenessKey` (unique) prevents concurrent/duplicate active documents:
///   INVOICE/PROFORMA/QUOTATION -> '<orderId>:<TYPE>' while active
///   CORRECTIVE_INVOICE        -> 'corrects:<originalDocumentId>'
model B2bDocument {
  id                 String            @id @default(cuid())
  orderId            String
  customerId         String
  type               B2bDocumentType
  status             B2bDocumentStatus @default(GENERATING)
  number             String            @unique @db.VarChar(50)
  issuedAt           DateTime
  total              Decimal           @db.Decimal(12, 2)
  payload            Json?
  storageKey         String?           @unique @db.VarChar(500)
  fileName           String?           @db.VarChar(255)
  fileSize           Int?
  generatedAt        DateTime?
  attempts           Int               @default(0)
  lastError          String?           @db.VarChar(500)
  lastAttemptAt      DateTime?
  uniquenessKey      String?           @unique @db.VarChar(120)
  correctsDocumentId String?
  correctionReason   String?           @db.Text
  createdBy          String?           @db.VarChar(120)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  order              B2bOrder          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer           B2bCustomer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  correctsDocument   B2bDocument?      @relation("B2bDocumentCorrection", fields: [correctsDocumentId], references: [id], onDelete: Restrict)
  corrections        B2bDocument[]     @relation("B2bDocumentCorrection")

  @@index([orderId])
  @@index([customerId])
  @@index([type, status])
}

/// Internal audit trail of B2B order events. NEVER exposed to customers.
model B2bOrderEvent {
  id        String            @id @default(cuid())
  orderId   String
  type      B2bOrderEventType
  actor     String?           @db.VarChar(120)  // 'customer' | 'admin:<email>' | 'system'
  metadata  Json?
  createdAt DateTime          @default(now())

  order     B2bOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}
