# --- Payment Gateway Configuration ---

# Redsys Configuration (Primary payment processor)
# Get these from your Redsys/bank account dashboard
# IMPORTANT: REDSYS_SECRET_KEY is server-only, NEVER expose to frontend
REDSYS_MERCHANT_CODE=999008881
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=your_secret_key_here
REDSYS_ENVIRONMENT=test  # Use "test" for sandbox, "production" for live

# Optional: Override Redsys URLs (defaults to sandbox/production URLs)
# REDSYS_URL_TEST=https://sis-t.redsys.es:25443/sis/realizarPago
# REDSYS_URL_PROD=https://sis.redsys.es/sis/realizarPago

# Legacy Stripe Configuration (DEPRECATED - kept for backward compatibility)
# These can be removed once fully migrated to Redsys
#NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#STRIPE_SECRET_KEY=rk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...

# Application URL for payment redirects (used in checkout success/error URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shipping configuration (shared by cart, mini-cart and checkout)
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=75
NEXT_PUBLIC_STANDARD_SHIPPING_COST=4.99  # Updated from 6.95 to 4.99

# Sentry (client + server)
SENTRY_DSN=https://0ef9ec88521642669a26f94cd1ee5ab2@o4511560243216384.ingest.de.sentry.io/4511560247345232
NEXT_PUBLIC_SENTRY_DSN=https://0ef9ec88521642669a26f94cd1ee5ab2@o4511560243216384.ingest.de.sentry.io/4511560247345232
SENTRY_AUTH_TOKEN=sntrys_your_auth_token_for_source_map_upload
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=tcg-iberia
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1.0

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Supplier Price Sync (Admin button + Vercel Cron) -----------------------
# JSON feed URL returning supplier rows (category/shrink/product/jpy). Only
# rows with category === "Pokemon Box" are processed.
SUPPLIER_PRICE_URL=https://samuraiswordinc.com/pricelist/data.json
# Bearer secret validated by app/api/cron/update-prices — set the same value
# in the Vercel project's environment variables and cron configuration.
CRON_SECRET=change-this-to-a-long-random-value

# --- B2B (Wholesale) Module -------------------------------------------------
# SMTP settings above (SMTP_HOST/PORT/USER/PASSWORD/FROM) are reused for all
# B2B transactional emails (docs request, activation, ready, disabled).
# ADMIN_EMAIL is the sales inbox that receives new-request notifications.
#
# No B2B-specific env vars are required � the module inherits DATABASE_URL,
# NEXT_PUBLIC_APP_URL (for activation links), and the SMTP settings above.
